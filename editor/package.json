{
  "name": "lumio-config-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/normalize-static.mjs",
    "lint": "eslint src tests scripts --max-warnings=0 && tsc --noEmit && node scripts/check-deps.mjs",
    "test": "vitest run && node scripts/check-deps.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check-deps": "node scripts/check-deps.mjs",
    "fixtures": "node scripts/generate-big-fixture.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@univerjs/core": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/preset-sheets-data-validation": "0.25.1",
    "@univerjs/preset-sheets-filter": "0.25.1",
    "@univerjs/preset-sheets-find-replace": "0.25.1",
    "@univerjs/preset-sheets-sort": "0.25.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.51.0",
    "@types/node": "22.13.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "jsdom": "26.0.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.11",
    "vitest": "3.0.5"
  }
}
